{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civicpulse.local/schemas/dataset_manifest.schema.json",
  "title": "CivicPulse synthetic dataset manifest (common envelope)",
  "type": "object",
  "required": ["dataset", "dataset_version", "synthetic", "rows"],
  "properties": {
    "dataset": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "pattern": "^synthetic_v[0-9]+\\.[0-9]+$" },
    "synthetic": { "const": true },
    "disclaimer": {
      "type": "string",
      "pattern": "SYNTHETIC"
    },
    "description": { "type": "string" },
    "rows": { "type": "array" }
  }
}
