{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civicpulse.local/schemas/demographic_indicator.schema.json",
  "title": "Synthetic demographic indicator row (FR-031 shape)",
  "type": "object",
  "required": ["location", "population"],
  "properties": {
    "location": {
      "type": "object",
      "required": ["state", "district"],
      "properties": {
        "state": { "type": "string" },
        "district": { "type": "string" },
        "block": { "type": ["string", "null"] },
        "village_ward": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    },
    "population": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "deprivation_index": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "indicator_name": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
