{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civicpulse.local/schemas/request.schema.json",
  "title": "Synthetic citizen request row (FR-001/002 shape)",
  "type": "object",
  "required": ["request_id", "channel", "language", "text", "location_text", "consent_ack"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^req_[a-z0-9]+$" },
    "channel": { "enum": ["text", "voice"] },
    "language": { "enum": ["hi", "mr", "en"] },
    "text": { "type": "string", "minLength": 3 },
    "location_text": { "type": ["string", "null"] },
    "consent_ack": { "const": true },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
