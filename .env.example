# ============================================================
# CivicPulse — environment template
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real secrets. `.env` is gitignored.
# Defaults below let the full stack run with NO paid API keys.
# ============================================================

# ---------- Application ----------
APP_ENV=development            # development | test | production
APP_NAME=CivicPulse
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------- Database (PostgreSQL + PostGIS) ----------
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse   # dev-only default; change locally, never commit real creds
POSTGRES_PORT=5432
# Hybrid workflow (db in Docker, backend on host). In Docker Compose the
# backend uses host "db" instead of "localhost".
DATABASE_URL=postgresql+psycopg2://civicpulse:civicpulse@localhost:5432/civicpulse

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000

# ---------- Auth (SCAFFOLD: demo-login boundary only) ----------
JWT_SECRET=change-me-dev-only-not-a-secret

# ---------- AI provider selection (all default to local mocks) ----------
AI_STT_PROVIDER=mock           # mock | whisper (Phase 1 PoC, Member C)
AI_LLM_PROVIDER=mock           # mock | (provider TBD by team, PRD §11)
AI_EMBEDDING_PROVIDER=mock     # mock | sentence-transformers / tfidf fallback
GEOCODING_PROVIDER=mock        # mock | gazetteer + OSM Nominatim fallback

# ---------- Optional future provider credentials (leave empty) ----------
OPENAI_API_KEY=
# OTHER_API_KEYS_IF_NEEDED=

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
